# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service-role key — server-only, bypasses Row-Level Security. Never expose
# this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio (aistudio.google.com) -> Get API Key. Free tier, no
# billing card required. All AI routes call through src/lib/ai-models.ts's
# three-leg AI_FALLBACK_CHAIN: gemini-3.5-flash-lite -> gemini-3.1-flash-lite
# -> Groq's openai/gpt-oss-120b (see GROQ_API_KEY below), which deliberately
# uses the Flash-Lite tier (~500 free requests/day) over plain Flash
# (~20/day) and auto-falls-back on a 503/429/timeout. Google retires Gemini
# model IDs on a published schedule (ai.google.dev/gemini-api/docs/deprecations)
# -- if ingestion or chat ever degrades with a 404-shaped failure, check that
# page and bump GEMINI_MODELS.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# Groq (console.groq.com) -> API Keys -> Create API Key. Free tier, no
# billing card required. This is the AI_FALLBACK_CHAIN's third/last leg,
# only reached if both Gemini models above fail retryably — a different
# vendor's capacity pool, so a Google-side outage can't take down the whole
# chain. openai/gpt-oss-120b currently gets 1,000 free requests/day on Groq
# (console.groq.com/docs/rate-limits), more generous than Gemini Flash-Lite's.
# Groq deprecates hosted models on a rolling basis
# (console.groq.com/docs/deprecations) -- if the Groq leg ever degrades with
# a 404-shaped failure, check console.groq.com/docs/models and bump
# GROQ_MODEL in src/lib/ai-models.ts.
GROQ_API_KEY=your-groq-api-key

# Shared secret between GitHub Actions and the /api/ingest route.
# Generate with: openssl rand -hex 32
CRON_SECRET=generate-a-long-random-string

# --- One-time bootstrap only (scripts/seed-super-admin.ts) -----------------
# These two are read ONLY by `npm run seed:super-admin`, run once by hand on
# your own machine. They are not read by the Next.js app itself — do not set
# them in Vercel's environment variables, and feel free to remove them from
# your local .env.local again once the super admin account is created.
SUPER_ADMIN_EMAIL=you@growthlysolutions.com
SUPER_ADMIN_PASSWORD=choose-your-own-strong-password-min-12-chars
